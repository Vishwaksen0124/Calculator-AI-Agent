# =========================================================
# Configuration for Strict Calculation Agent
# =========================================================

# LLM Provider: 'ollama' (default, free local) or 'gemini' (free cloud tier)
LLM_PROVIDER=ollama

# Ollama Settings (100% Free & Local - No API Key Needed)
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://localhost:11434

# Google Gemini Settings (Free Tier Cloud Option)
# If using Gemini, set your API key and provider to 'gemini'
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.0-flash
